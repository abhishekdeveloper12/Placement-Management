# Server Environment Configuration (Placeholder Template)
# Copy this file to .env and configure your local environment settings

# Server Port
PORT=5000

# Node Runtime Environment (development | production | test)
NODE_ENV=development

# MongoDB Connection String
# Example: mongodb://localhost:27017/placement_management
# Or Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/placement_management
MONGODB_URI=mongodb://localhost:27017/placement_management

# Allowed CORS Origin for Client Requests
CORS_ORIGIN=http://localhost:5173

# Authentication JWT Configuration (Placeholders - Generate cryptographically secure keys for production)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_here
JWT_REFRESH_EXPIRES_IN=7d

# Permanent Super Admin Bootstrap Credentials
SUPER_ADMIN_EMAIL=superadmin@placementmanagement.local
SUPER_ADMIN_PASSWORD=ChangeMe@12345
